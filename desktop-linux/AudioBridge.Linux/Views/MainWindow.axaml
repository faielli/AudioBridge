<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AudioBridge.Desktop.ViewModels"
        xmlns:controls="using:AudioBridge.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="800"
        x:Class="AudioBridge.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://AudioBridge.Desktop/Assets/audiobridge.ico"
        Title="AudioBridge"
        Background="{DynamicResource BackgroundBrush}"
        Width="520" Height="760"
        MinWidth="400" MinHeight="500">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources />

    <Grid RowDefinitions="*,Auto">

        <!-- ========== MAIN CONTENT ========== -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="460" HorizontalAlignment="Center" Margin="32 40 32 32" Spacing="24">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="headline" Text="AudioBridge" HorizontalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost"
                            Width="36" Height="36"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="Impostazioni"
                            FontSize="20"
                            Padding="0">
                        <TextBlock Text="&#x2699;" />
                    </Button>
                </Grid>
                <TextBlock Classes="body-small" Text="Trasmetti l'audio del PC al tuo telefono" HorizontalAlignment="Center" />

                <!-- Connection status -->
                <Border Classes="card-default">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <controls:ConnectionPulseIndicator State="{Binding ConnectionState}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Classes="body" Text="{Binding StatusText}" />
                                <TextBlock Classes="body-small"
                                           Text="{Binding StreamInfo}"
                                           TextWrapping="Wrap" />
                                <TextBlock Classes="body-small"
                                           Text="{Binding StreamInfoSecondary}"
                                           IsVisible="{Binding HasStreamInfoSecondary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Latency display (visible when streaming) -->
                        <StackPanel Spacing="10"
                                    IsVisible="{Binding IsStreaming}">
                            <Separator />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="label" Text="Latenza" VerticalAlignment="Center" />
                            <TextBlock Classes="numeric-large"
                                       Text="{Binding LatencyDisplay}"
                                       Foreground="{Binding LatencyBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- VU meter -->
                <Border Classes="card-default"
                        IsVisible="{Binding IsStreaming}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="label" Text="Livello audio" />
                        <ProgressBar Value="{Binding PeakLevel}"
                                     Minimum="0" Maximum="1"
                                     Height="12"
                                     CornerRadius="6"
                                     Foreground="{DynamicResource AccentSecondaryBrush}"
                                     Background="{DynamicResource BorderBrush}" />
                    </StackPanel>
                </Border>

                <!-- Profile selector -->
                <Border Classes="card-default">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="label" Text="Profilo audio" />
                        <ListBox ItemsSource="{Binding Profiles}"
                                 SelectedIndex="{Binding SelectedProfile}"
                                 HorizontalAlignment="Center"
                                 BorderThickness="1"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 CornerRadius="10"
                                 Background="Transparent">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerTheme>
                                <ControlTheme TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter Property="Padding" Value="28,10" />
                                    <Setter Property="FontFamily" Value="{DynamicResource FontFamily.UI}" />
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="FontWeight" Value="Medium" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </ControlTheme>
                            </ListBox.ItemContainerTheme>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Start / Stop button -->
                <Button Classes="primary"
                        Command="{Binding ToggleStreamingCommand}"
                        Height="52"
                        HorizontalContentAlignment="Center"
                        FontSize="16">
                    <TextBlock Text="{Binding StreamButtonText}"
                               FontWeight="SemiBold" />
                </Button>

            </StackPanel>
        </ScrollViewer>

        <!-- ========== STATUS BAR ========== -->
        <Border Grid.Row="1" Padding="16,10"
                Background="{DynamicResource SurfaceBrush}">
            <TextBlock Classes="body-small" Text="{Binding CaptureInfo}"
                       TextTrimming="CharacterEllipsis" />
        </Border>

    </Grid>
</Window>
